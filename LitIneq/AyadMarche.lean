theorem Ayad_Marche :
    ∀ r : ℝ, |r| ≤ 1 →
      |0.9890365552 + 1.130258690 * r + 0.5540440796 * r * r - Real.exp r|
        ≤ (1 - (2 : ℝ) ^ (-16 : ℤ)) * (2 : ℝ) ^ (-4 : ℤ) := by
  intro r hr
  have h_interval : -1 ≤ r ∧ r ≤ 1 := by
    exact abs_le.mp hr
  have h_lower : -1 ≤ r := h_interval.1
  have h_upper : r ≤ 1 := h_interval.2
  have h_exp_pos : 0 < Real.exp r := by
    exact Real.exp_pos r
  have h_sq_nonneg : 0 ≤ r * r := by
    nlinarith [sq_nonneg r]
  have h_sq_le_one : r * r ≤ 1 := by
    have hpow : r ^ 2 ≤ (1 : ℝ) := by
      exact (sq_le_one_iff_abs_le_one r).2 hr
    nlinarith [hpow]
  have h_zpow_neg_four_pos : 0 < (2 : ℝ) ^ (-4 : ℤ) := by
    exact zpow_pos (by norm_num : (0 : ℝ) < 2) (-4 : ℤ)
  have h_rhs_eval :
      (1 - (2 : ℝ) ^ (-16 : ℤ)) * (2 : ℝ) ^ (-4 : ℤ) =
        (65535 : ℝ) / 1048576 := by
    norm_num
  have h_rhs_pos :
      0 < (1 - (2 : ℝ) ^ (-16 : ℤ)) * (2 : ℝ) ^ (-4 : ℤ) := by
    rw [h_rhs_eval]
    norm_num
  let err : ℝ :=
    0.9890365552 + 1.130258690 * r + 0.5540440796 * r * r - Real.exp r
  let taylor5 : ℝ := ∑ m ∈ Finset.range 6, r ^ m / m.factorial
  have h_exp_taylor5_raw :
      |Real.exp r - taylor5| ≤
        |r| ^ 6 * (((6 : ℕ).succ : ℝ) / ((Nat.factorial 6 : ℝ) * 6)) := by
    simpa [taylor5] using
      (Real.exp_bound (x := r) (n := 6) hr (by norm_num : 0 < 6))
  have h_exp_taylor5 :
      |Real.exp r - taylor5| ≤ (7 : ℝ) / 4320 := by
    have h_abs_pow : |r| ^ 6 ≤ (1 : ℝ) := by
      exact pow_le_one₀ (abs_nonneg r) hr
    calc
      |Real.exp r - taylor5|
          ≤ |r| ^ 6 * (((6 : ℕ).succ : ℝ) / ((Nat.factorial 6 : ℝ) * 6)) :=
            h_exp_taylor5_raw
      _ ≤ 1 * (((6 : ℕ).succ : ℝ) / ((Nat.factorial 6 : ℝ) * 6)) := by
        gcongr
      _ = (7 : ℝ) / 4320 := by
        norm_num [Nat.factorial]
  have h_err_decomp :
      err =
        ((0.9890365552 + 1.130258690 * r + 0.5540440796 * r * r) - taylor5) -
          (Real.exp r - taylor5) := by
    dsimp [err, taylor5]
    ring
  have h_tri :
      |err| ≤
        |(0.9890365552 + 1.130258690 * r + 0.5540440796 * r * r) - taylor5| +
          |Real.exp r - taylor5| := by
    dsimp [err]
    simpa [taylor5, abs_sub_comm] using
      (abs_sub_le
        (0.9890365552 + 1.130258690 * r + 0.5540440796 * r * r)
        taylor5
        (Real.exp r))
  have h_budget :
      (1 : ℝ) / 20 + (7 : ℝ) / 4320 ≤
        (1 - (2 : ℝ) ^ (-16 : ℤ)) * (2 : ℝ) ^ (-4 : ℤ) := by
    rw [h_rhs_eval]
    norm_num
  let polyErr : ℝ :=
    (0.9890365552 + 1.130258690 * r + 0.5540440796 * r * r) - taylor5
  have h_polyErr_form :
      polyErr =
        - r ^ 5 / 120 - r ^ 4 / 24 - r ^ 3 / 6 +
          (135110199 : ℝ) / 2500000000 * r ^ 2 +
          (13025869 : ℝ) / 100000000 * r -
          (6852153 : ℝ) / 625000000 := by
    dsimp [polyErr, taylor5]
    norm_num [Finset.sum_range_succ, Nat.factorial]
    ring_nf
  have h_reduce :
      |polyErr| ≤ (1 : ℝ) / 20 →
        |0.9890365552 + 1.130258690 * r + 0.5540440796 * r * r - Real.exp r|
          ≤ (1 - (2 : ℝ) ^ (-16 : ℤ)) * (2 : ℝ) ^ (-4 : ℤ) := by
    intro h_poly
    have h_poly_direct :
        |(0.9890365552 + 1.130258690 * r + 0.5540440796 * r * r) - taylor5|
          ≤ (1 : ℝ) / 20 := by
      simpa [polyErr] using h_poly
    have h_err_bound : |err| ≤ (1 : ℝ) / 20 + (7 : ℝ) / 4320 := by
      linarith [h_tri, h_poly_direct, h_exp_taylor5]
    have h_err_bound' :
        |err| ≤ (1 - (2 : ℝ) ^ (-16 : ℤ)) * (2 : ℝ) ^ (-4 : ℤ) := by
      exact le_trans h_err_bound h_budget
    simpa [err] using h_err_bound'
  have h_poly_bound : |polyErr| ≤ (1 : ℝ) / 20 := by
    have hcase1 : r ≤ -(1 : ℝ) / 2 ∨ -(1 : ℝ) / 2 ≤ r := le_total r (-(1 : ℝ) / 2)
    rcases hcase1 with h_left | h_right
    · let x : ℝ := 2 * (r + 1)
      have hx0 : 0 ≤ x := by
        dsimp [x]
        nlinarith
      have hx1 : x ≤ 1 := by
        dsimp [x]
        nlinarith
      have h_upper : polyErr ≤ (1 : ℝ) / 20 := by
        have h_nonneg : 0 ≤
            ((1 : ℝ) / 20 - (173082293 : ℝ) / 3750000000) * (1 - x) ^ 5 +
              ((1 : ℝ) / 20 - (815424841 : ℝ) / 75000000000) * (5 * x * (1 - x) ^ 4) +
              ((1 : ℝ) / 20 - (-(883570823 : ℝ) / 60000000000)) * (10 * x ^ 2 * (1 - x) ^ 3) +
              ((1 : ℝ) / 20 - (-(9504576997 : ℝ) / 300000000000)) * (10 * x ^ 3 * (1 - x) ^ 2) +
              ((1 : ℝ) / 20 - (-(6155484641 : ℝ) / 150000000000)) * (5 * x ^ 4 * (1 - x)) +
              ((1 : ℝ) / 20 - (-(1322765597 : ℝ) / 30000000000)) * x ^ 5 := by
          positivity
        have h_eq :
            ((1 : ℝ) / 20 - (173082293 : ℝ) / 3750000000) * (1 - x) ^ 5 +
              ((1 : ℝ) / 20 - (815424841 : ℝ) / 75000000000) * (5 * x * (1 - x) ^ 4) +
              ((1 : ℝ) / 20 - (-(883570823 : ℝ) / 60000000000)) * (10 * x ^ 2 * (1 - x) ^ 3) +
              ((1 : ℝ) / 20 - (-(9504576997 : ℝ) / 300000000000)) * (10 * x ^ 3 * (1 - x) ^ 2) +
              ((1 : ℝ) / 20 - (-(6155484641 : ℝ) / 150000000000)) * (5 * x ^ 4 * (1 - x)) +
              ((1 : ℝ) / 20 - (-(1322765597 : ℝ) / 30000000000)) * x ^ 5 =
              (1 : ℝ) / 20 - polyErr := by
          dsimp [x]
          rw [h_polyErr_form]
          ring_nf
        nlinarith
      have h_lower : -((1 : ℝ) / 20) ≤ polyErr := by
        have h_nonneg : 0 ≤
            ((173082293 : ℝ) / 3750000000 + (1 : ℝ) / 20) * (1 - x) ^ 5 +
              ((815424841 : ℝ) / 75000000000 + (1 : ℝ) / 20) * (5 * x * (1 - x) ^ 4) +
              ((-(883570823 : ℝ) / 60000000000) + (1 : ℝ) / 20) * (10 * x ^ 2 * (1 - x) ^ 3) +
              ((-(9504576997 : ℝ) / 300000000000) + (1 : ℝ) / 20) * (10 * x ^ 3 * (1 - x) ^ 2) +
              ((-(6155484641 : ℝ) / 150000000000) + (1 : ℝ) / 20) * (5 * x ^ 4 * (1 - x)) +
              ((-(1322765597 : ℝ) / 30000000000) + (1 : ℝ) / 20) * x ^ 5 := by
          positivity
        have h_eq :
            ((173082293 : ℝ) / 3750000000 + (1 : ℝ) / 20) * (1 - x) ^ 5 +
              ((815424841 : ℝ) / 75000000000 + (1 : ℝ) / 20) * (5 * x * (1 - x) ^ 4) +
              ((-(883570823 : ℝ) / 60000000000) + (1 : ℝ) / 20) * (10 * x ^ 2 * (1 - x) ^ 3) +
              ((-(9504576997 : ℝ) / 300000000000) + (1 : ℝ) / 20) * (10 * x ^ 3 * (1 - x) ^ 2) +
              ((-(6155484641 : ℝ) / 150000000000) + (1 : ℝ) / 20) * (5 * x ^ 4 * (1 - x)) +
              ((-(1322765597 : ℝ) / 30000000000) + (1 : ℝ) / 20) * x ^ 5 =
              polyErr + (1 : ℝ) / 20 := by
          dsimp [x]
          rw [h_polyErr_form]
          ring_nf
        nlinarith
      exact abs_le.mpr ⟨h_lower, h_upper⟩
    · have hcase2 : r ≤ (0 : ℝ) ∨ (0 : ℝ) ≤ r := le_total r 0
      rcases hcase2 with h_nonpos | h_nonneg_r
      · let x : ℝ := 2 * (r + (1 : ℝ) / 2)
        have hx0 : 0 ≤ x := by
          dsimp [x]
          nlinarith
        have hx1 : x ≤ 1 := by
          dsimp [x]
          nlinarith
        have h_upper : polyErr ≤ (1 : ℝ) / 20 := by
          have h_nonneg : 0 ≤
              ((1 : ℝ) / 20 - (-(1322765597 : ℝ) / 30000000000)) * (1 - x) ^ 5 +
                ((1 : ℝ) / 20 - (-(2357390443 : ℝ) / 50000000000)) * (5 * x * (1 - x) ^ 4) +
                ((1 : ℝ) / 20 - (-(13171323749 : ℝ) / 300000000000)) * (10 * x ^ 2 * (1 - x) ^ 3) +
                ((1 : ℝ) / 20 - (-(3566408081 : ℝ) / 100000000000)) * (10 * x ^ 3 * (1 - x) ^ 2) +
                ((1 : ℝ) / 20 - (-(119946569 : ℝ) / 5000000000)) * (5 * x ^ 4 * (1 - x)) +
                ((1 : ℝ) / 20 - (-(6852153 : ℝ) / 625000000)) * x ^ 5 := by
            positivity
          have h_eq :
              ((1 : ℝ) / 20 - (-(1322765597 : ℝ) / 30000000000)) * (1 - x) ^ 5 +
                ((1 : ℝ) / 20 - (-(2357390443 : ℝ) / 50000000000)) * (5 * x * (1 - x) ^ 4) +
                ((1 : ℝ) / 20 - (-(13171323749 : ℝ) / 300000000000)) * (10 * x ^ 2 * (1 - x) ^ 3) +
                ((1 : ℝ) / 20 - (-(3566408081 : ℝ) / 100000000000)) * (10 * x ^ 3 * (1 - x) ^ 2) +
                ((1 : ℝ) / 20 - (-(119946569 : ℝ) / 5000000000)) * (5 * x ^ 4 * (1 - x)) +
                ((1 : ℝ) / 20 - (-(6852153 : ℝ) / 625000000)) * x ^ 5 =
                (1 : ℝ) / 20 - polyErr := by
            dsimp [x]
            rw [h_polyErr_form]
            ring_nf
          nlinarith
        have h_lower : -((1 : ℝ) / 20) ≤ polyErr := by
          have h_nonneg : 0 ≤
              ((-(1322765597 : ℝ) / 30000000000) + (1 : ℝ) / 20) * (1 - x) ^ 5 +
                ((-(2357390443 : ℝ) / 50000000000) + (1 : ℝ) / 20) * (5 * x * (1 - x) ^ 4) +
                ((-(13171323749 : ℝ) / 300000000000) + (1 : ℝ) / 20) * (10 * x ^ 2 * (1 - x) ^ 3) +
                ((-(3566408081 : ℝ) / 100000000000) + (1 : ℝ) / 20) * (10 * x ^ 3 * (1 - x) ^ 2) +
                ((-(119946569 : ℝ) / 5000000000) + (1 : ℝ) / 20) * (5 * x ^ 4 * (1 - x)) +
                ((-(6852153 : ℝ) / 625000000) + (1 : ℝ) / 20) * x ^ 5 := by
            positivity
          have h_eq :
              ((-(1322765597 : ℝ) / 30000000000) + (1 : ℝ) / 20) * (1 - x) ^ 5 +
                ((-(2357390443 : ℝ) / 50000000000) + (1 : ℝ) / 20) * (5 * x * (1 - x) ^ 4) +
                ((-(13171323749 : ℝ) / 300000000000) + (1 : ℝ) / 20) * (10 * x ^ 2 * (1 - x) ^ 3) +
                ((-(3566408081 : ℝ) / 100000000000) + (1 : ℝ) / 20) * (10 * x ^ 3 * (1 - x) ^ 2) +
                ((-(119946569 : ℝ) / 5000000000) + (1 : ℝ) / 20) * (5 * x ^ 4 * (1 - x)) +
                ((-(6852153 : ℝ) / 625000000) + (1 : ℝ) / 20) * x ^ 5 =
                polyErr + (1 : ℝ) / 20 := by
            dsimp [x]
            rw [h_polyErr_form]
            ring_nf
          nlinarith
        exact abs_le.mpr ⟨h_lower, h_upper⟩
      · have hcase3 : r ≤ (1 : ℝ) / 2 ∨ (1 : ℝ) / 2 ≤ r := le_total r ((1 : ℝ) / 2)
        rcases hcase3 with h_le_half | h_ge_half
        · let x : ℝ := 2 * r
          have hx0 : 0 ≤ x := by
            dsimp [x]
            nlinarith
          have hx1 : x ≤ 1 := by
            dsimp [x]
            nlinarith
          have h_upper : polyErr ≤ (1 : ℝ) / 20 := by
            have h_nonneg : 0 ≤
                ((1 : ℝ) / 20 - (-(6852153 : ℝ) / 625000000)) * (1 - x) ^ 5 +
                  ((1 : ℝ) / 20 - (10312121 : ℝ) / 5000000000) * (5 * x * (1 - x) ^ 4) +
                  ((1 : ℝ) / 20 - (1643939519 : ℝ) / 100000000000) * (10 * x ^ 2 * (1 - x) ^ 3) +
                  ((1 : ℝ) / 20 - (9025240451 : ℝ) / 300000000000) * (10 * x ^ 3 * (1 - x) ^ 2) +
                  ((1 : ℝ) / 20 - (6058871471 : ℝ) / 150000000000) * (5 * x ^ 4 * (1 - x)) +
                  ((1 : ℝ) / 20 - (1319370103 : ℝ) / 30000000000) * x ^ 5 := by
              positivity
            have h_eq :
                ((1 : ℝ) / 20 - (-(6852153 : ℝ) / 625000000)) * (1 - x) ^ 5 +
                  ((1 : ℝ) / 20 - (10312121 : ℝ) / 5000000000) * (5 * x * (1 - x) ^ 4) +
                  ((1 : ℝ) / 20 - (1643939519 : ℝ) / 100000000000) * (10 * x ^ 2 * (1 - x) ^ 3) +
                  ((1 : ℝ) / 20 - (9025240451 : ℝ) / 300000000000) * (10 * x ^ 3 * (1 - x) ^ 2) +
                  ((1 : ℝ) / 20 - (6058871471 : ℝ) / 150000000000) * (5 * x ^ 4 * (1 - x)) +
                  ((1 : ℝ) / 20 - (1319370103 : ℝ) / 30000000000) * x ^ 5 =
                  (1 : ℝ) / 20 - polyErr := by
              dsimp [x]
              rw [h_polyErr_form]
              ring_nf
            nlinarith
          have h_lower : -((1 : ℝ) / 20) ≤ polyErr := by
            have h_nonneg : 0 ≤
