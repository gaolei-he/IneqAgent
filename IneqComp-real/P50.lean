private theorem four_fractions (a b c d p q r s : ℝ)
    (hp : p ≠ 0) (hq : q ≠ 0) (hr : r ≠ 0) (hs : s ≠ 0) :
    a/p+b/q+c/r+d/s-1 =
      (a*q*r*s+b*p*r*s+c*p*q*s+d*p*q*r-p*q*r*s)/(p*q*r*s) := by
  field_simp
  <;> ring

