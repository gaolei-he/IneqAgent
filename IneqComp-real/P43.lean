theorem real_p43 (a b c : ℝ) (h : a^2 + b^2 + c^2 = 1) (h_domain : a * b * c ≠ 0) : 1 / a^2 + 1 / b^2 + 1 / c^2 - 2 * (a^3 + b^3 + c^3) / (a * b * c) ≥ 3 := by
  have hnum : (0 : ℝ) ≤ -2*a^4*b*c - 3*a^2*b^2*c^2 + a^2*b^2 + a^2*c^2 - 2*a*b^4*c - 2*a*b*c^4 + b^2*c^2 := by
    have hbackend : (0 : ℝ) ≤ ((-1)*(2)*((a)^4)*(b)*(c)) + ((-1)*(3)*((a)^2)*((b)^2)*((c)^2)) + (((a)^2)*((b)^2)) + (((a)^2)*((c)^2)) + ((-1)*(2)*(a)*((b)^4)*(c)) + ((-1)*(2)*(a)*(b)*((c)^4)) + (((b)^2)*((c)^2)) := by
      have heh1 : (((a)^2) + ((b)^2) + ((c)^2) + (-1)) = (0 : ℝ) := by nlinarith
      have hzh1 : (11/46 + (3/46)*(c^2) + (-5/46)*b*c + (3/46)*(b^2) + (-5/46)*a*c + (-5/46)*a*b + (3/46)*(a^2) + (-7/23)*(c^4) + (5/46)*b*(c^3) + (-17/23)*(b^2)*(c^2) + (5/46)*(b^3)*c + (-7/23)*(b^4) + (5/46)*a*(c^3) + (-35/46)*a*b*(c^2) + (-35/46)*a*(b^2)*c + (5/46)*a*(b^3) + (-17/23)*(a^2)*(c^2) + (-35/46)*(a^2)*b*c + (-17/23)*(a^2)*(b^2) + (5/46)*(a^3)*c + (5/46)*(a^3)*b + (-7/23)*(a^4)) * (((a)^2) + ((b)^2) + ((c)^2) + (-1)) = (0 : ℝ) := by rw [heh1]; ring
      have hs0 : (0 : ℝ) ≤ (46/11)*((11/46) - (11/46)*(a^2) - (11/46)*(b^2) - (11/46)*(c^2))^2 + (23/7)*(-(5/92)*a - (5/92)*b + (7/23)*c + (5/92)*(a^3) - (15/92)*(a^2)*b - (2/23)*(a^2)*c - (15/92)*a*(b^2) + (5/92)*a*(c^2) + (5/92)*(b^3) - (2/23)*(b^2)*c + (5/92)*b*(c^2) - (7/23)*(c^3))^2 + (112/33)*(-(165/2576)*a + (33/112)*b + (165/2576)*(a^3) - (13/112)*(a^2)*b - (5/28)*(a^2)*c + (65/2576)*a*(b^2) - (395/2576)*a*(c^2) - (33/112)*(b^3) + (25/644)*(b^2)*c - (199/2576)*b*(c^2))^2 + (1058/297)*((297/1058)*a - (297/1058)*(a^3) - (117/1058)*a*(b^2) - (117/1058)*a*(c^2) - (90/529)*(b^2)*c - (90/529)*b*(c^2))^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (759/559)*(-(100/759)*(a^2)*b + (100/759)*(a^2)*c + (100/759)*a*(b^2) - (559/759)*a*(c^2) - (100/759)*(b^2)*c + (559/759)*b*(c^2))^2 + (141427/100827)*((15300/141427)*(a^2)*b - (15300/141427)*(a^2)*c - (100827/141427)*a*(b^2) + (100827/141427)*(b^2)*c)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (659/459)*(-(459/659)*(a^2)*b + (459/659)*(a^2)*c)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 := by positivity
      have hid : (((-1)*(2)*((a)^4)*(b)*(c)) + ((-1)*(3)*((a)^2)*((b)^2)*((c)^2)) + (((a)^2)*((b)^2)) + (((a)^2)*((c)^2)) + ((-1)*(2)*(a)*((b)^4)*(c)) + ((-1)*(2)*(a)*(b)*((c)^4)) + (((b)^2)*((c)^2))) = (((46/11)*((11/46) - (11/46)*(a^2) - (11/46)*(b^2) - (11/46)*(c^2))^2 + (23/7)*(-(5/92)*a - (5/92)*b + (7/23)*c + (5/92)*(a^3) - (15/92)*(a^2)*b - (2/23)*(a^2)*c - (15/92)*a*(b^2) + (5/92)*a*(c^2) + (5/92)*(b^3) - (2/23)*(b^2)*c + (5/92)*b*(c^2) - (7/23)*(c^3))^2 + (112/33)*(-(165/2576)*a + (33/112)*b + (165/2576)*(a^3) - (13/112)*(a^2)*b - (5/28)*(a^2)*c + (65/2576)*a*(b^2) - (395/2576)*a*(c^2) - (33/112)*(b^3) + (25/644)*(b^2)*c - (199/2576)*b*(c^2))^2 + (1058/297)*((297/1058)*a - (297/1058)*(a^3) - (117/1058)*a*(b^2) - (117/1058)*a*(c^2) - (90/529)*(b^2)*c - (90/529)*b*(c^2))^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (759/559)*(-(100/759)*(a^2)*b + (100/759)*(a^2)*c + (100/759)*a*(b^2) - (559/759)*a*(c^2) - (100/759)*(b^2)*c + (559/759)*b*(c^2))^2 + (141427/100827)*((15300/141427)*(a^2)*b - (15300/141427)*(a^2)*c - (100827/141427)*a*(b^2) + (100827/141427)*(b^2)*c)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2 + (659/459)*(-(459/659)*(a^2)*b + (459/659)*(a^2)*c)^2 + (0/1)*(0/1)^2 + (0/1)*(0/1)^2) + (11/46 + (3/46)*(c^2) + (-5/46)*b*c + (3/46)*(b^2) + (-5/46)*a*c + (-5/46)*a*b + (3/46)*(a^2) + (-7/23)*(c^4) + (5/46)*b*(c^3) + (-17/23)*(b^2)*(c^2) + (5/46)*(b^3)*c + (-7/23)*(b^4) + (5/46)*a*(c^3) + (-35/46)*a*b*(c^2) + (-35/46)*a*(b^2)*c + (5/46)*a*(b^3) + (-17/23)*(a^2)*(c^2) + (-35/46)*(a^2)*b*c + (-17/23)*(a^2)*(b^2) + (5/46)*(a^3)*c + (5/46)*(a^3)*b + (-7/23)*(a^4))*(((a)^2) + ((b)^2) + ((c)^2) + (-1))) := by ring
      rw [hid]
      linarith
    convert hbackend using 1 <;> ring
  change _ ≤ _
  rw [← sub_nonneg]
  have ha_ne : a ≠ 0 := by intro hz; apply h_domain; simp [hz]
  have hb_ne : b ≠ 0 := by intro hz; apply h_domain; simp [hz]
  have hc_ne : c ≠ 0 := by intro hz; apply h_domain; simp [hz]
  have hden : (0 : ℝ) < a^2*b^2*c^2 := by positivity
  have hfrac : (-3 + (1 / ((c) ^ 2)) + (1 / ((b) ^ 2)) - (2*a^3 + 2*b^3 + 2*c^3)/(a*b*c) + (1 / ((a) ^ 2))) = (-2*a^4*b*c - 3*a^2*b^2*c^2 + a^2*b^2 + a^2*c^2 - 2*a*b^4*c - 2*a*b*c^4 + b^2*c^2) / (a^2*b^2*c^2) := by
    field_simp
    <;> ring
  have hgoal : (0 : ℝ) ≤ -3 + (1 / ((c) ^ 2)) + (1 / ((b) ^ 2)) - (2*a^3 + 2*b^3 + 2*c^3)/(a*b*c) + (1 / ((a) ^ 2)) := by
    rw [hfrac]
    exact div_nonneg hnum (le_of_lt hden)
  convert hgoal using 1 <;> field_simp <;> ring

end Lean92.IneqComp_real_P43


theorem real_p43 (a b c : ℝ) (ha : a > 0) (hb : b > 0) (hc : c > 0) (h : a^2 + b^2 + c^2 = 1) : 1 / a^2 + 1 / b^2 + 1 / c^2 - 2 * (a^3 + b^3 + c^3) / (a * b * c) ≥ 3 := by
  exact @Lean92.IneqComp_real_P43.real_p43 a b c h (by positivity)

