/-- Parse space-separated nonnegative integer data. -/
def parseNatText (text : String) : Array Nat :=
  text.splitOn " " |>.foldl (fun output token =>
    match token.toNat? with
    | some value => output.push value
    | none => output) #[]


/-- Zero-based position of an upper-triangular entry. -/
def upperIndex (i j : Nat) : Nat :=
  let a := min i j
  let b := max i j
  a * dimension - a * (a - 1) / 2 + (b - a)

def upperNumerator (i j : Fin dimension) : Int :=
  upperNumerators.getD (upperIndex i.val j.val) 0

/-- Exact rational Gram entry reconstructed from integer data. -/
def gram (i j : Fin dimension) : ℚ :=
  (upperNumerator i j : ℚ) / (commonDenominator : ℚ)

/-- The exact 325 x 325 Gram matrix. -/
