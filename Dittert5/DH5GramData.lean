/-- Parse the exact ASCII integer data once it is evaluated. -/
def parseUpperText (text : String) : Array Int :=
  text.splitOn " " |>.foldl (fun output token =>
    match token.toInt? with
    | some value => output.push value
    | none => output) #[]

